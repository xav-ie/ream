{
  description = "ream — on-demand PDF tools (Go API + Astro UI)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-parts.url = "github:hercules-ci/flake-parts";
    treefmt-nix.url = "github:numtide/treefmt-nix";
    treefmt-nix.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs =
    inputs@{ flake-parts, treefmt-nix, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      systems = [
        "x86_64-linux"
        "aarch64-linux"
      ];
      imports = [ treefmt-nix.flakeModule ];

      perSystem =
        { config, pkgs, ... }:
        let
          # The trimmed LibreOffice and headless ghostscript the image ships,
          # so the tests and dev shell run what Cloudflare runs.
          ghostscript = pkgs.ghostscript_headless;
          libreoffice = pkgs.callPackage ./libreoffice-headless.nix { };
          # CLI tools the server (and its tests) shell out to.
          tools = [
            ghostscript
            libreoffice
            pkgs.img2pdf
            pkgs.pdfcpu
            pkgs.poppler-utils
            pkgs.qpdf
          ];
        in
        {
          packages.ream = pkgs.callPackage ./package.nix { inherit ghostscript libreoffice; };
          packages.default = config.packages.ream;

          treefmt =
            _:
            let
              # Format go.mod via `go mod edit -fmt`, as dots does.
              goModFormatterModule =
                { mkFormatterModule, ... }:
                {
                  imports = [
                    (mkFormatterModule {
                      name = "go-mod-fmt";
                      package = "go";
                      args = [
                        "mod"
                        "edit"
                        "-fmt"
                      ];
                      includes = [ "**/go.mod" ];
                    })
                  ];
                };
            in
            {
              imports = [ goModFormatterModule ];
              projectRootFile = "flake.nix";
              programs = {
                deadnix.enable = true;
                statix.enable = true;
                nixfmt.enable = true;
                gofmt.enable = true;
                go-mod-fmt.enable = true;
                prettier.enable = true;
                ruff-format.enable = true;
                shfmt.enable = true;
              };
              settings = {
                formatter.shfmt.includes = [
                  "scripts/podman-docker"
                  "scripts/update-pnpm-hash"
                ];
                formatter.prettier.includes = [ "*.jsonc" ];
                on-unmatched = "fatal";
                excludes = [
                  "frontend/**" # formatted + checked by its own pnpm prettier (astro plugin)
                  ".dev.vars.example"
                  ".github/logo.svg"
                  "docs/diagrams/*.svg" # generated by scripts/diagrams.mjs
                  ".dockerignore"
                  ".node-version"
                  "Dockerfile"
                  "pnpm-lock.yaml"
                  "worker-configuration.d.ts" # generated by `pnpm types`
                  "**/.gitignore"
                  ".envrc"
                  "flake.lock"
                  "go.sum"
                  "*.lock"
                  "result"
                  ".direnv/**"
                ];
              };
            };

          checks = {
            # The package must build (frontend + Go + wrapper).
            build = config.packages.default;

            # Behavioural tests of the API/CLI operations against generated fixtures.
            gotest =
              pkgs.runCommand "ream-gotest"
                {
                  nativeBuildInputs = [ pkgs.go ] ++ tools;
                }
                ''
                  cp -r ${./.} src && chmod -R +w src && cd src
                  export HOME="$TMPDIR" GOCACHE="$TMPDIR/go" GOFLAGS=-mod=mod GOPROXY=off CGO_ENABLED=0
                  go vet ./...
                  go test ./...
                  touch "$out"
                '';
          };

          devShells.default = pkgs.mkShell {
            packages = [
              pkgs.go
              pkgs.gopls
              pkgs.gotools
              pkgs.nodejs_24
              pkgs.pnpm_10
              config.treefmt.build.wrapper
            ]
            ++ tools;
            # `cd frontend && pnpm install` then `REAM_WEBROOT=frontend/dist go run .`.
            REAM_WEBROOT = "frontend/dist";
            # wrangler builds the container image with `docker`; when that is
            # podman's shim, route it through the flag-stripping wrapper.
            shellHook = ''
              if [ "$(basename "$(readlink -f "$(command -v docker)")")" = podman ]; then
                export WRANGLER_DOCKER_BIN="$PWD/scripts/podman-docker"
              fi
            '';
          };
        };
    };
}
