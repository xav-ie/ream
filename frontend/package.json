{
  "name": "ream-frontend",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "concurrently -c auto 'pnpm:check:*'",
    "check:astro": "astro check --minimumFailingSeverity hint",
    "check:fallow": "fallow",
    "check:format": "prettier --check .",
    "check:knip": "knip",
    "check:lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@unocss/astro": "^66.6.8",
    "astro": "^6.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "fallow": "^2.67.0",
    "globals": "^17.6.0",
    "knip": "^6.12.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "unocss": "^66.6.8"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "pdfjs-dist": "^6.0.227"
  }
}
